# Database Configuration
# REQUIRED: Database connection URI
# Format: postgresql://user:password@host:port/database
# Example: postgresql://dbuser:secretpass@localhost:5432/mydb
# MySQL: mysql+pymysql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# AI Provider Configuration
# Choose which AI provider to use: 'auto' (try all), 'openai', or 'claude'
AI_PROVIDER=auto

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Required if using OpenAI for AI-powered migration generation
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic Claude Configuration
# Get your API key from: https://console.anthropic.com/
# Required if using Claude for AI-powered migration generation
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security Configuration
# IMPORTANT: Set this to your frontend URL in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Migration Configuration
MIGRATIONS_DIR=migrations
MIGRATION_TABLE=schema_migrations

# Compliance Configuration
# Enforce compliance checks before applying migrations
ENFORCE_COMPLIANCE=true
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Feature Flags
ENABLE_AI_GENERATION=true
ENABLE_SCHEMA_INTERCEPTION=true
ENABLE_WEBSOCKET=true
